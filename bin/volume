#!/bin/bash

update_notification() {
    sleep 0.1

    current_vol=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '/%/ {print $5; exit}')
    mute_state=$(pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}')

    vol_num="${current_vol%\%}"

    if [ "$mute_state" = "yes" ]; then
        icon="audio-volume-muted"
        message="Volume: Muted"
    else
        if [ "$vol_num" -eq 0 ]; then
            icon="audio-volume-off"
        elif [ "$vol_num" -lt 33 ]; then
            icon="audio-volume-low"
        elif [ "$vol_num" -lt 66 ]; then
            icon="audio-volume-medium"
        else
            icon="audio-volume-high"
        fi
        message="Volume: $current_vol"
    fi

    dunstify -i "$icon" "$message" -t 1000 -r 1 -h int:value:"$vol_num"
}

update_mic_notification() {
    sleep 0.1

    mic_mute_state=$(pactl get-source-mute @DEFAULT_SOURCE@ | awk '{print $2}')

    if [ "$mic_mute_state" = "yes" ]; then
        icon="microphone-sensitivity-muted"
        message="Microphone: Muted"
    else
        icon="microphone-sensitivity-high"
        message="Microphone: Unmuted"
    fi

    dunstify -i "$icon" "$message" -t 1000 -r 2
}

if [[ -z "$1" ]]; then
    echo "Usage: $0 {up|down|mute|micmute}"
    exit 1
fi

STEP=10%

case "$1" in
    up)
        pactl set-sink-volume @DEFAULT_SINK@ +$STEP
        update_notification
        ;;
    down)
        pactl set-sink-volume @DEFAULT_SINK@ -$STEP
        update_notification
        ;;
    mute)
        pactl set-sink-mute @DEFAULT_SINK@ toggle
        update_notification
        ;;
    micmute)
        pactl set-source-mute @DEFAULT_SOURCE@ toggle
        update_mic_notification
        ;;
    *)
        echo "Invalid argument: Use 'up', 'down', 'mute', or 'micmute'"
        exit 1
        ;;
esac
