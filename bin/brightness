#!/bin/bash
#
# Updates the brightness having at least 10% cause 0% is scaryyyyy...
# (C) 2025 Dany Gagnon <dany@ovior.ca> - MIT License

MIN_PERCENT=10

if [ -z "$1" ]; then
    echo "Usage: $0 [+/-]PERCENT"
    exit 1
fi

current=$(brightnessctl get)
max=$(brightnessctl max)

percent=$(( current * 100 / max ))

delta="$1"

delta_num=$(echo "$delta" | tr -d '+')
new_percent=$(( percent + delta_num ))

if [ "$new_percent" -lt "$MIN_PERCENT" ]; then
    new_percent=$MIN_PERCENT
fi

if [ "$new_percent" -gt 100 ]; then
    new_percent=100
fi

brightnessctl set "${new_percent}%"

dunstify -i display-brightness-medium "Brightness: ${new_percent}%" -t 1000 -r 3 -h int:value:"${new_percent}"
