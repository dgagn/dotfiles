(defcfg
    process-unmapped-keys yes
)

(defvar
    tap-time 130
    hold-time 130
)

(defalias
    a-mod (tap-hold $tap-time $hold-time a rctl)
    s-mod (tap-hold $tap-time $hold-time s lalt)
    f-mod (tap-hold $tap-time $hold-time f lsft)
    ;-mod (tap-hold $tap-time $hold-time ; rctl)
    l-mod (tap-hold $tap-time $hold-time l lalt)
    j-mod (tap-hold $tap-time $hold-time j rsft)

    rsft_ (tap-hold $tap-time $hold-time (macro S-') rsft)

    esc-acc (tap-hold $tap-time $hold-time esc (layer-toggle accent))
    prog (tap-hold $tap-time $hold-time XX (layer-toggle prog))

    enter (tap-hold $tap-time $hold-time enter (layer-toggle prog))
)

(defsrc
    = 1 2 3 4 5
    q w e r t
    esc a s d f g
    lsft z x c v b
    caps

    6 7 8 9 0 -
    y u i o p \
    h j k l ; '
    n m , . / rsft
    enter
)

(deflayer default
    = 1 2 3 4 5
    q w e r t
    @esc-acc @a-mod @s-mod d @f-mod g
    lsft z x c v b
    @prog

    6 7 8 9 0 -
    y u i o p \
    h @j-mod k @l-mod @;-mod '
    n m , . / @rsft_
    @enter
)

(deflayer prog
    = A-1 A-2 A-3 A-4 A-5
    S-7 S-8 S-[ S-] S-\
    esc S-6 S-4 S-9 S-0 \
    lsft S-5 S-3 [ ] S-`
    @prog

    A-6 A-7 A-8 A-9 A-0 `
    y u i o p \
    left down up right ; '
    n m , . / rsft
    @enter
)

(deflayer accent
    = 1 2 3 4 5
    (macro RA-`) (macro RA-` e) (macro RA-' e) (macro RA-6 e) (macro RA-6)
    esc (macro RA-` a) s d f (macro RA-S-')
    lsft z x (macro RA-,) v b
    @prog

    6 7 8 9 0 -
    y u i o p \
    h j k l ; '
    n m , . / rsft
    @enter
)

(deflayer accent-caps
    = 1 2 3 4 5
    q w e r t
    esc a s d f g
    lsft z x c v b
    caps

    6 7 8 9 0 -
    y u i o p \
    h j k l ; '
    n m , . / rsft
    @enter
)
