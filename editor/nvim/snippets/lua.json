{
    "if": {
        "prefix": "if",
        "body": ["if ${1:true} then", "\t$0", "end"]
    },
    "elseif": {
        "prefix": "elseif",
        "body": ["elseif ${1:true} then", "\t$0"]
    },
    "for": {
	"prefix": "for",
        "body": ["for ${1:i} = ${2:1}, ${3:10} do", "\t$0", "end"],
        "description": "for loop range"
    },
    "forpair": {
        "prefix": "forp",
        "body": ["for i, ${1:x} in pairs(${2:table}) do", "\t$0", "end"]
    },
    "foripair": {
        "prefix": "fori",
        "body": ["for i, ${1:x} in ipairs(${2:table}) do", "\t$0", "end"]
    },
    "function": {
	"prefix": "fun",
	"body": ["function $1($2)", "\t${0}", "end"]
    },
    "function": {
	"prefix": "fn",
	"body": ["function $1($2)", "\t${0}", "end"]
    },
    "while": {
        "prefix": "w",
        "body": ["while ${1:true} do", "\t$0", "end"]
    },
    "require": {
	"prefix": "req",
	"body": ["require(${1:module})"],
	"description": "require a module"
    },
    "local": {
	"prefix": "l",
	"body": ["local ${0}"],
	"description": "declare a variable"
    }
}
